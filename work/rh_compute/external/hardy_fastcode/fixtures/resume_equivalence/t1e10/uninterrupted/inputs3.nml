! input parameters:
! tighter 15-value interoperability fixture
! the upstream parser skips exactly nine lines
! before reading et and the 45-character T string
! this fixture separates requested tolerance from asymptotic error
! it is diagnostic only and independently checked
! no physical RH row is inferred
! retain the upstream fixed-width input format
&inputs
et=0.00500
YT = '1.0000000000000000000000000000000000000000e10'
! retain this skipped line before numbercalc
numbercalc = 8
