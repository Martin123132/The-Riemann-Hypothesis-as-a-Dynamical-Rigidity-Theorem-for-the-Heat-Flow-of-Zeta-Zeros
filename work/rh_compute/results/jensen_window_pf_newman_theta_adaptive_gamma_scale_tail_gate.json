  "proof_boundary": "This artifact proves an explicit cofinal gamma-scale upper bound for the omitted modular tail with N(x)=ceil((1+x)^(3/4)) and x>=245. It does not lower-bound the retained J_N or J_N' first jet, certify the finite bridge 69<x<245, prove a terminating retained transition cover, establish strict Laguerre positivity, prove Lambda<=0 or RH, or supply a Clay-prize result.",
  "rows": [
    {
      "claim": "The adaptive count N(x)=ceil((1+x)^(3/4)) partitions the positive axis into exact half-open cells.",
      "diagnostics": null,
      "formula": "C_N=((N-1)^(4/3)-1,N^(4/3)-1], N(x)=N on C_N",
      "id": "ntagstg_01_adaptive_cell_partition",
      "proof_boundary": "Exact ceiling arithmetic.",
      "readiness": "proved",
      "role": "exact_identity"
    },
    {
      "claim": "For x>=245 and fixed N, each gamma-normalized m=9 error multiplier increases with x, so the cell maximum is its right endpoint.",
      "diagnostics": null,
      "formula": "d/dx log(exp(pi*x/8)/x^s)=pi/8-s/x>0, s in {5,6}",
      "id": "ntagstg_02_within_cell_monotonicity",
      "proof_boundary": "The d0 and d1 budgets are constant on each cell.",
      "readiness": "proved",
      "role": "exact_inequality"
    },
    {
      "claim": "Every forward template decreases after gamma normalization from N=63 onward.",
      "diagnostics": null,
      "formula": "log(F_(N+1)/F_N)+pi*(x_(N+1)-x_N)/8<=D/(N+1)-pi*(2N+3)+pi*Delta_N/8<0, D<=20",
      "id": "ntagstg_03_forward_endpoint_monotonicity",
      "proof_boundary": "The denominator theta increases and the geometric ratio rho_F decreases with N.",
      "readiness": "proved",
      "role": "exact_inequality"
    },
    {
      "claim": "Every compact-reflected template decreases after gamma normalization from N=63 onward.",
      "diagnostics": null,
      "formula": "log(C_(N+1)/C_N)+pi*(x_(N+1)-x_N)/8<=D/(N+1)-pi*(2N+3)/sqrt(2)+pi*Delta_N/8<0, D<=22",
      "id": "ntagstg_04_compact_endpoint_monotonicity",
      "proof_boundary": "The compact geometric ratio decreases with N.",
      "readiness": "proved",
      "role": "exact_inequality"
    },
    {
      "claim": "Every large-reflected unimodal tail decreases after gamma normalization from N=63 onward.",
      "diagnostics": null,
      "formula": "G_A(y)=exp(pi*y^(4/3)/8)[f_A(y)+integral_y^infinity f_A]; G_A'<0 if (4/3)(c_safe-pi/8)y^(1/3)-A/y>0",
      "id": "ntagstg_05_large_endpoint_monotonicity",
      "proof_boundary": "For f_A=y^A exp(-c_safe*y^(4/3)), integral_y^infinity f_A<=f_A/h_A and h_A is increasing.",
      "readiness": "proved",
      "role": "exact_inequality"
    },
    {
      "claim": "Positive Leibniz and Hermite coefficients preserve the three template monotonicity statements for full d0 and d1.",
      "diagnostics": null,
      "formula": "d0_N,d1_N are fixed positive linear combinations of the forward, compact-reflected, and large-reflected templates",
      "id": "ntagstg_06_positive_composition",
      "proof_boundary": "No cancellation is used in the error theorem.",
      "readiness": "proved",
      "role": "exact_composition"
    },
