  "proof_boundary": "This gate proves that every real regular field occurs in an even, negative-rooted positive-coefficient finite genus-zero model with an exact Newman-style first-loss heat boundary, for every multiplicity m>=2. It proves no bound for the actual Xi field, no degree-uniform Jensen remainder, no Xi collision exclusion, Lambda<=0, RH, or prize-level conclusion.",
  "rows": [
    {
      "certificate": "Three parent artifacts are audited before construction.",
      "claim": "The first-Xi-jet, positive-boundary, and first-jet contracts are hash-pinned.",
      "id": "rfn_01_sources",
      "proof_boundary": "No parent theorem is strengthened.",
      "readiness": "proved",
      "role": "source chain"
    },
    {
      "certificate": "A=ell^2+2, B=ell^2-ell+2=(ell-1/2)^2+7/4, alpha=1-1/A, beta=1+1/B; A>1, B>0, and therefore 0<alpha<1<beta for every real ell.",
      "claim": "The two auxiliary root scales exist for every real ell.",
      "id": "rfn_02_parameters",
      "proof_boundary": "This is exact real algebra.",
      "readiness": "proved",
      "role": "arbitrary-field parameters"
    },
    {
      "certificate": "F_(m,ell,c)(s)=(s+c^2)^m(s+alpha*c^2)(s+beta*c^2), m>=2, c>0",
      "claim": "The model is a finite genus-zero Laguerre-Polya product.",
      "id": "rfn_03_product",
      "proof_boundary": "It is a model source, not Xi itself.",
      "readiness": "proved",
      "role": "negative-root product"
    },
    {
      "certificate": "All factors s+a*c^2 have a>0, so F has only negative zeros and strictly positive coefficients.",
      "claim": "Every s-coordinate coefficient is strictly positive.",
      "id": "rfn_04_coefficients",
      "proof_boundary": "Coefficient positivity alone is only a shared structural feature.",
      "readiness": "proved",
      "role": "coefficient geometry"
    },
    {
      "certificate": "At rho=-c^2, rho*U'(rho)/U(rho)=A-B=ell; the inner and outer simple zeros contribute A and -B exactly.",
      "claim": "Every prescribed real ell is attained exactly.",
      "id": "rfn_05_field",
      "proof_boundary": "The field is at the selected multiplicity-m root.",
      "readiness": "proved",
      "role": "regular-field realization"
    },
    {
      "certificate": "H_(m,ell,c)(x)=F_(m,ell,c)(-x^2) is even and real-rooted, with multiplicity m at each of +/-c.",
      "claim": "The signed-variable model is even and entirely real-rooted at contact.",
      "id": "rfn_06_even",
      "proof_boundary": "The lift has two symmetric contacts at +/-c.",
      "readiness": "proved",
      "role": "even lift"
    },
    {
      "certificate": "If H(x)=(x-c)^m V(x), then V'(c)/V(c)=m/(2c)-2c*U'(rho)/U(rho)=(m+4ell)/(2c).",
      "claim": "The s-field gives an arbitrary signed-variable regular field.",
      "id": "rfn_07_conversion",
      "proof_boundary": "This is a local logarithmic derivative identity.",
      "readiness": "proved",
      "role": "signed field conversion"
    },
    {
      "certificate": "For tau>=0, exp(-tau*D_x^2)=lim_(N->infinity)[(1-sqrt(tau/N)D_x)(1+sqrt(tau/N)D_x)]^N; each real first-order factor preserves real-rootedness.",
      "claim": "Every nonnegative heat time remains real-rooted.",
      "id": "rfn_08_preserver",
      "proof_boundary": "The proof is for the finite polynomial model.",
      "readiness": "proved",
      "role": "forward heat flow"
    },
    {
      "certificate": "tau^(-m/2)H_tau(c+sqrt(tau)z)/V(c) -> P_m^-(z)=exp(-D_z^2)z^m=2^(m/2)He_m(z/sqrt(2)).",
      "claim": "The contact opens into the universal real Hermite cluster.",
      "id": "rfn_09_forward",
      "proof_boundary": "Local parabolic scaling only.",
      "readiness": "proved",
      "role": "forward cluster"
    },
    {
      "certificate": "P_(m+1)^-=zP_m^--2(P_m^-)' implies every forward cluster root has x_j(tau)=c+sqrt(tau)h_j+2[V'(c)/V(c)]tau+O(tau^(3/2)).",
      "claim": "The field translates every leading cluster root without changing hyperbolicity.",
      "id": "rfn_10_drift",
      "proof_boundary": "The O(tau) formula is local at one contact.",
      "readiness": "proved",
      "role": "regular-field drift"
    },
    {
      "certificate": "For sigma=-tau>0, sigma^(-m/2)H_(-sigma)(c+sqrt(sigma)z)/V(c) -> P_m^+(z)=exp(D_z^2)z^m. P_m^+ has no real zero for even m and only z=0 for odd m.",
      "claim": "A nonreal pair appears immediately on the negative-time side.",
      "id": "rfn_11_backward",
      "proof_boundary": "Root continuity is applied at fixed finite m.",
      "readiness": "proved",
      "role": "backward cluster"
    },
    {
      "certificate": "H_tau is real-rooted for every tau>=0 and is not real-rooted for all sufficiently small tau<0; heat monotonicity makes its exact Newman threshold tau=0.",
      "claim": "Each model has exact Newman-style threshold zero.",
      "id": "rfn_12_boundary",
      "proof_boundary": "This is a polynomial heat-flow threshold, not the Xi Newman constant.",
      "readiness": "proved",
      "role": "exact first loss"
    },
    {
      "certificate": "Exact Hermite audits cover m=2 through 16; the closed formulas prove arbitrary fixed m.",
      "claim": "The construction and local split work for every m>=2.",
      "id": "rfn_13_multiplicity",
      "proof_boundary": "Finite audit range checks implementation only.",
      "readiness": "guard_validated",
      "role": "all-multiplicity audit"
    },
    {
      "certificate": "The first-loss heat condition, evenness, finite genus-zero negative-root geometry, and positive s-coefficients impose no bound or sign on ell.",
      "claim": "First-loss dynamics supplies no universal sign or bound for ell.",
      "id": "rfn_14_nonclosure",
      "proof_boundary": "Xi-specific global restrictions are not refuted.",
      "readiness": "proved",
      "role": "local no-go theorem"
    },
    {
      "certificate": "Any bound on the hypothetical Xi field must use structure absent from these models, such as the theta/Fourier source, global zero placement, or zero first-jet boundary winding.",
      "claim": "A useful field bound must use actual Xi global structure.",
      "id": "rfn_15_xi",
      "proof_boundary": "No such Xi bound is proved here.",
      "readiness": "open",
      "role": "Xi-specific field handoff"
    },
    {
      "certificate": "The cofinal Jensen route separately still needs a remainder estimate uniform in the selected degree sequence.",
      "claim": "The Jensen collision route still needs uniform analytic error control.",
      "id": "rfn_16_uniform",
      "proof_boundary": "No degree-uniform remainder, collision exclusion, Lambda<=0, or RH is proved.",
      "readiness": "open",
      "role": "degree-uniform handoff"
    }
  ],
